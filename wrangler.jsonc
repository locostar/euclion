{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "euclion",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "keep_vars": true,
  "vars": {
    "BETTER_AUTH_URL": "https://euclion.locostartt.workers.dev"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "euclion",
      "database_id": "34becc88-8dd8-4ce6-91d6-86d5554aa4cf",
      "migrations_dir": "migrations"
    }
  ]
}
